    // ─── .autochat on/off ────────────────────────
    autochat: async (ctx) => {
        const { sock, msg, from, args, react, isOwner } = ctx;

        const cmd = (args[0] || '').toLowerCase();

        // Owner can control global
        if (isOwner) {
            if (cmd === 'on') autoReplyEnabled = true;
            else if (cmd === 'off') autoReplyEnabled = false;
            else if (cmd === 'toggle') autoReplyEnabled = !autoReplyEnabled;

            await react(autoReplyEnabled ? '🤖' : '💤');
            return sock.sendMessage(from, {
                text: `╭─⬡ 🤖 *GLOBAL AUTOCHAT* ╡\n` +
                      `│\n` +
                      `│  📊 ${autoReplyEnabled ? '✅ ON' : '❌ OFF'}\n` +
                      `│  💡 Sab users ke liye\n` +
                      `│\n` +
                      `╰─────────────────────────╯`
            }, { quoted: msg });
        }

        // Regular user: per-chat toggle
        const current = userEnabled[from] !== false;
        const newState = cmd === 'on' ? true : cmd === 'off' ? false : !current;
        userEnabled[from] = newState;

        await react(newState ? '🤖' : '💤');
        await sock.sendMessage(from, {
            text: `╭─⬡ 🤖 *YOUR AUTOCHAT* ╡\n` +
