// ─── Streak ──────────────────────────────────────
function calculateStreak() {
    if (lifeData.mood.length === 0) return 0;
    const dates = [...new Set(lifeData.mood.map(m => m.date))].sort().reverse();
    let streak = 1;
    for (let i = 1; i < dates.length; i++) {
        const d1 = new Date(dates[i - 1].split('/').reverse().join('-'));
        const d2 = new Date(dates[i].split('/').reverse().join('-'));
        const diff = Math.floor((d1 - d2) / (1000 * 60 * 60 * 24));
        if (diff === 1) streak++;
        else break;
    }
    return streak;
}