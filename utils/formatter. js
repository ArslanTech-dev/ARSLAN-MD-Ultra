const moment = require('moment-timezone');

// ─── Timezone Configuration ─────────────────────
const PK_TIMEZONE = 'Asia/Karachi';

// ─── Pakistan Time (Full) ────────────────────────
function pkTime() {
    return moment().tz(PK_TIMEZONE).format('hh:mm:ss A');
}

// ─── Pakistan Time (Short) ───────────────────────
function pkTimeShort() {
    return moment().tz(PK_TIMEZONE).format('hh:mm A');
}

// ─── Pakistan Date (Full) ────────────────────────
function pkDate() {
    return moment().tz(PK_TIMEZONE).format('DD MMMM YYYY');
}

// ─── Pakistan Date (Short) ───────────────────────
function pkDateShort() {
    return moment().tz(PK_TIMEZONE).format('DD/MM/YYYY');
}

// ─── Pakistan Date & Time ────────────────────────
function pkDateTime() {
    return moment().tz(PK_TIMEZONE).format('DD MMM YYYY, hh:mm A');
}

// ─── Day Name ────────────────────────────────────
function dayName() {
    return moment().tz(PK_TIMEZONE).format('dddd');
}

// ─── Time Ago ────────────────────────────────────
function timeAgo(timestamp) {
    return moment(timestamp).fromNow();
}

// ─── Format Timestamp ────────────────────────────
function formatTimestamp(timestamp, format = 'DD MMM YYYY, hh:mm A') {
    return moment(timestamp).tz(PK_TIMEZONE).format(format);
}

// ─── Format Number with Commas ───────────────────
function formatNumber(num) {
    if (isNaN(num)) return '0';
    return Number(num).toLocaleString('en-PK');
}

// ─── Format Currency (PKR) ───────────────────────
function formatPKR(amount) {
    if (isNaN(amount)) return 'Rs. 0';
    return 'Rs. ' + Number(amount).toLocaleString('en-PK');
}

// ─── Format Currency (USD) ───────────────────────
function formatUSD(amount) {
    if (isNaN(amount)) return '$0.00';
    return '$' + Number(amount).toFixed(2);
}

// ─── Format Percentage ───────────────────────────
function formatPercent(value, decimals = 1) {
    if (isNaN(value)) return '0%';
    return Number(value).toFixed(decimals) + '%';
}

// ─── Format File Size ────────────────────────────
function formatFileSize(bytes) {
    if (bytes === 0) return '0 B';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB';
    if (bytes < 1024 * 1024 * 1024) return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    return (bytes / 1024 / 1024 / 1024).toFixed(2) + ' GB';
}

// ─── Format Duration ─────────────────────────────
function formatDuration(seconds) {
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);

    if (d > 0) return `${d}d ${h}h ${m}m`;
    if (h > 0) return `${h}h ${m}m ${s}s`;
    if (m > 0) return `${m}m ${s}s`;
    return `${s}s`;
}

// ─── Format Phone Number ─────────────────────────
function formatPhone(phone) {
    if (!phone) return '';
    const clean = String(phone).replace(/[^0-9]/g, '');
    if (clean.length < 10) return clean;
    return '+' + clean;
}

// ─── Format JID to Phone ─────────────────────────
function jidToPhone(jid) {
    if (!jid) return '';
    return jid.split('@')[0];
}

// ─── Format Phone to JID ─────────────────────────
function phoneToJid(phone) {
    if (!phone) return '';
    const clean = String(phone).replace(/[^0-9]/g, '');
    return `${clean}@s.whatsapp.net`;
}

// ─── Truncate Text ───────────────────────────────
function truncateText(text, maxLength = 50) {
    if (!text) return '';
    if (text.length <= maxLength) return text;
    return text.slice(0, maxLength - 3) + '...';
}

// ─── Capitalize Words ────────────────────────────
function capitalizeWords(text) {
    if (!text) return '';
    return text.replace(/\b\w/g, l => l.toUpperCase());
}

// ─── To Title Case ───────────────────────────────
function titleCase(text) {
    if (!text) return '';
    const small = ['a', 'an', 'the', 'of', 'and', 'or', 'in', 'on', 'at', 'to', 'for'];
    return text
        .toLowerCase()
        .split(' ')
        .map((word, i) => 
            (i === 0 || !small.includes(word)) ? word.charAt(0).toUpperCase() + word.slice(1) : word
        )
        .join(' ');
}

// ─── Format List (Array) ─────────────────────────
function formatList(arr, bullet = '➤') {
    if (!Array.isArray(arr) || arr.length === 0) return '';
    return arr.map((item, i) => `${bullet} ${item}`).join('\n');
}

// ─── Format List with Numbers ────────────────────
function formatNumberedList(arr) {
    if (!Array.isArray(arr) || arr.length === 0) return '';
    return arr.map((item, i) => `${i + 1}. ${item}`).join('\n');
}

// ─── Format Menu Section ─────────────────────────
function formatMenuSection(title, commands, prefix = '.') {
    let text = `『 ${title} 』─╮\n`;
    commands.forEach(cmd => {
        text += `│ ➤${prefix}${cmd}\n`;
    });
    text += `╰─────────────────────────╯\n\n`;
    return text;
}

// ─── Format Key-Value ────────────────────────────
function formatKV(key, value, width = 15) {
    const paddedKey = String(key).padEnd(width, ' ');
    return `│  ${paddedKey}: ${value}`;
}

// ─── Format Box Header ───────────────────────────
function formatBoxHeader(title, width = 43) {
    const line = '═'.repeat(width - 2);
    return `╔${line}╗\n║  ${title.padEnd(width - 4)}  ║\n╚${line}╝`;
}

// ─── Format Box Footer ───────────────────────────
function formatBoxFooter(text, width = 43) {
    const line = '═'.repeat(width - 2);
    return `╔${line}╗\n║  ${text.padEnd(width - 4)}  ║\n╚${line}╝`;
}

// ─── Progress Bar ────────────────────────────────
function formatProgressBar(percent, length = 15) {
    if (percent < 0) percent = 0;
    if (percent > 100) percent = 100;
    const filled = Math.round((percent / 100) * length);
    const empty = length - filled;
    return '▓'.repeat(filled) + '░'.repeat(empty) + ` ${percent.toFixed(0)}%`;
}

// ─── Star Rating ─────────────────────────────────
function formatStars(rating, max = 5) {
    const full = Math.round(rating);
    const empty = max - full;
    return '⭐'.repeat(full) + '☆'.repeat(empty);
}

// ─── Format Bytes to Human ──────────────────────
function humanBytes(bytes) {
    const units = ['B', 'KB', 'MB', 'GB', 'TB'];
    let i = 0;
    let size = bytes;
    while (size >= 1024 && i < units.length - 1) {
        size /= 1024;
        i++;
    }
    return `${size.toFixed(2)} ${units[i]}`;
}

// ─── Format IP Address ───────────────────────────
function formatIP(ip) {
    if (!ip) return '0.0.0.0';
    return String(ip).trim();
}

// ─── Format URL ──────────────────────────────────
function formatUrl(url) {
    if (!url) return '';
    if (!url.startsWith('http://') && !url.startsWith('https://')) {
        return 'https://' + url;
    }
    return url;
}

// ─── Escape Markdown ─────────────────────────────
function escapeMarkdown(text) {
    if (!text) return '';
    return String(text).replace(/[_*[\]()~`>#+\-=|{}.!]/g, '\\$&');
}

// ─── Format WhatsApp Bold ────────────────────────
function bold(text) {
    return `*${text}*`;
}

function italic(text) {
    return `_${text}_`;
}

function strike(text) {
    return `~${text}~`;
}

function mono(text) {
    return '```' + text + '```';
}

// ─── Export All ──────────────────────────────────
module.exports = {
    // Time & Date
    pkTime,
    pkTimeShort,
    pkDate,
    pkDateShort,
    pkDateTime,
    dayName,
    timeAgo,
    formatTimestamp,

    // Numbers
    formatNumber,
    formatPKR,
    formatUSD,
    formatPercent,
    formatFileSize,
    formatDuration,
    humanBytes,

    // Phone & JID
    formatPhone,
    jidToPhone,
    phoneToJid,

    // Text
    truncateText,
    capitalizeWords,
    titleCase,
    escapeMarkdown,

    // Lists
    formatList,
    formatNumberedList,
    formatMenuSection,
    formatKV,

    // Boxes
    formatBoxHeader,
    formatBoxFooter,
    formatProgressBar,
    formatStars,

    // Network
    formatIP,
    formatUrl,

    // WhatsApp Formatting
    bold,
    italic,
    strike,
    mono
};